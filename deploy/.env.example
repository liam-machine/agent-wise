# =============================================================================
# Wiseway Staff Assistant — environment template
# =============================================================================
# Copy this file to deploy/.env and fill in the generated secrets below:
#
#     cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored. The DEMO shared secrets in this template
# (WISEWAY_MCP_SHARED_SECRET, OPENID_CLIENT_SECRET) are intentional placeholders
# for a local demo — fine to keep as-is. The CRYPTO secrets below MUST be
# regenerated (see the one-liner in each section) — do NOT ship the examples.
# =============================================================================

# -----------------------------------------------------------------------------
# App branding / server
# -----------------------------------------------------------------------------
APP_TITLE=Wiseway Assistant
HOST=0.0.0.0
PORT=3080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Service name "mongodb" resolves on the compose network. DB name "LibreChat".
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Public base URLs — REQUIRED. LibreChat builds absolute links (including the
# OIDC callback redirect_uri) from these; if unset, OIDC login fails with
# "Invalid URL".
DOMAIN_SERVER=http://localhost:3080
DOMAIN_CLIENT=http://localhost:3080

# -----------------------------------------------------------------------------
# LibreChat crypto secrets — REQUIRED, app will not start without them.
# Generate fresh values with the official helper:
#     https://www.librechat.ai/toolkit/creds_generator
# Or locally:
#     JWT_SECRET / JWT_REFRESH_SECRET / CREDS_KEY : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (64 hex chars)
#     CREDS_IV                                    : node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"   (32 hex chars)
# Replace EVERY placeholder below before deploying.
JWT_SECRET=REPLACE_ME_64_hex_chars_0000000000000000000000000000000000000000
JWT_REFRESH_SECRET=REPLACE_ME_64_hex_chars_1111111111111111111111111111111111111111
CREDS_KEY=REPLACE_ME_64_hex_chars_2222222222222222222222222222222222222222
CREDS_IV=REPLACE_ME_32_hex_chars_33333333

# -----------------------------------------------------------------------------
# Registration / login policy
# -----------------------------------------------------------------------------
# Demo is OIDC-only: no self-registration, no email/password, social (OIDC) on.
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=false
ALLOW_SOCIAL_LOGIN=true

# -----------------------------------------------------------------------------
# OpenID Connect — LOCAL DEV points at the mock Wiseway IdP (phone + PIN sim).
# INTEGRATE: repoint these at Wiseway's real SSO (OAuth2/OIDC) — see docs/INTEGRATION.md §1.
# -----------------------------------------------------------------------------
# Issuer MUST be HTTPS (LibreChat rejects a plain-HTTP issuer) and must resolve
# the SAME way in the browser AND in the container. For local dev add to
# /etc/hosts (one-time):   127.0.0.1 host.docker.internal
OPENID_ISSUER=https://host.docker.internal:9000
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=wiseway-demo-secret
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SCOPE=openid profile email
OPENID_USERNAME_CLAIM=preferred_username
OPENID_NAME_CLAIM=name
OPENID_EMAIL_CLAIM=email
OPENID_AUTO_REDIRECT=true
OPENID_BUTTON_LABEL=Wiseway Staff Login
# Session signing secret for the OIDC flow. Regenerate like the crypto secrets above.
OPENID_SESSION_SECRET=REPLACE_ME_64_hex_chars_4444444444444444444444444444444444444444

# -----------------------------------------------------------------------------
# Wiseway MCP doc-search shared secret
# -----------------------------------------------------------------------------
# LibreChat injects this as the X-Mcp-Key header; the MCP service rejects any
# request whose key does not match. Demo placeholder — fine to keep for local use.
WISEWAY_MCP_SHARED_SECRET=wiseway-mcp-shared-secret

# -----------------------------------------------------------------------------
# Microsoft Graph backend (the "machine login") for the doc-search service.
# INTEGRATE: needed only when WISEWAY_DOC_BACKEND=graph (real SharePoint).
# Register an Entra app + grant Sites.Selected read on the target site — see
# ENTRA-APP-SETUP.md and docs/INTEGRATION.md §3. REAL creds go in deploy/.env only.
# -----------------------------------------------------------------------------
# TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# SHAREPOINT_HOSTNAME=contoso.sharepoint.com
# SHAREPOINT_SITE_PATH=sites/YourHRSite
# SHAREPOINT_DRIVE_ID=
