# Secrets / local config (never commit) ---------------------------------------
deploy/.env
**/.env
*.local.env
*.secret
**/*.secret

# Local-only demo data + scripts (dev machine only — never commit, never prod) -
# e.g. deploy/seed-feedback.local.{js,sh}: sample feedback for the dashboard.
**/*.local.js
**/*.local.sh

# Generated self-signed certs (run mock-idp/gen-certs.sh) ----------------------
mock-idp/certs/

# Dependencies ----------------------------------------------------------------
**/node_modules/

# Local datastore (named docker volume; ignore stray bind mounts) --------------
deploy/data-node/

# OS / editor cruft -----------------------------------------------------------
.DS_Store
*.log

# eval harness — generated secrets & artifacts
eval/.env
eval/agents.json
eval/promptfoo/promptfooconfig.generated.json
eval/promptfoo/results.json
eval/promptfoo/.promptfoo/
eval/raw-extract/

# --- Sensitive: real Wiseway SOP content (names + internal procedures) — LOCAL ONLY ---
# The eval harness/scripts are committed; the document data is not (public repo).
docs/SOP/
eval/questions/
eval/build/
eval/promptfoo/results*.json
# Real-SOP-derived corpus (the original synthetic contoso docs stay tracked).
sample-docs/abf-77g-general-obligations.md
sample-docs/depot-warehouse-operations-sop.md
sample-docs/generating-cl-and-tns.md
sample-docs/security-response-sop.md
